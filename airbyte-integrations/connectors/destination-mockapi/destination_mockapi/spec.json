{
  "documentationUrl": "https://docs.airbyte.com/integrations/destinations/mockapi",
  "supported_destination_sync_modes": ["append", "overwrite"],
  "supportsIncremental": false,
  "supportsNormalization": false,
  "supportsDBT": false,
  "connectionSpecification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MockAPI Destination",
    "type": "object",
    "required": ["api_url"],
    "properties": {
      "api_url": {
        "title": "API URL",
        "type": "string",
        "description": "MockAPI endpoint URL (e.g., https://your-project-id.mockapi.io/api/v1)",
        "examples": ["https://68cc13e1716562cf50764f2b.mockapi.io/api/v1"],
        "pattern": "^https://[a-zA-Z0-9]+\\.mockapi\\.io/api/v[0-9]+$",
        "order": 0
      },
      "batch_size": {
        "title": "Batch Size",
        "type": "integer",
        "description": "Number of records to process in each batch. Larger batches may improve performance but use more memory.",
        "default": 100,
        "minimum": 1,
        "maximum": 1000,
        "order": 1
      },
      "timeout": {
        "title": "Request Timeout",
        "type": "integer",
        "description": "Request timeout in seconds for API calls.",
        "default": 30,
        "minimum": 5,
        "maximum": 300,
        "order": 2
      }
    }
  }
}